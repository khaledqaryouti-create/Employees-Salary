  NOT_APPLICABLE
}

// ─── DVR READINESS & COMPLIANCE GATE ──────────────────────────────────────────

enum DvrStatus {
  SETUP
  DATA_COLLECTION
  READINESS_REVIEW
  ASSESSMENT_IN_PROGRESS
  CONSULTATION_AND_APPROVAL
  APPROVED_AND_MONITORED
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TrainingRecordStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
}

enum IncidentType {
  ACCIDENT
  NEAR_MISS
  DANGEROUS_OCCURRENCE
  OCCUPATIONAL_DISEASE
}

enum IncidentSeverity {
  FATAL
  MAJOR
  MINOR
  FIRST_AID_ONLY
  NO_INJURY
}

enum IncidentStatus {
  REPORTED
  UNDER_INVESTIGATION
  CORRECTIVE_ACTIONS_ASSIGNED
  CLOSED
}

enum CorrectiveActionPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum SafetyRoleType {
  EMPLOYER
  RSPP
  ASPP
  RLS
  RLST
  MEDICO_COMPETENTE
  MANAGER
  SUPERVISOR
  FIRST_AID
  FIRE_EMERGENCY
}

model Asset {
  id                 String             @id @default(cuid())
  organizationId     String
  branchId           String?
  assetTypeId        String
  assetType          AssetType          @relation(fields: [assetTypeId], references: [id])
  name               String
  serialNumber       String?
  assetTag           String?
  acquisitionCost    Decimal            @db.Decimal(14,2)
  residualValue      Decimal            @default(0) @db.Decimal(14,2)
  acquisitionDate    DateTime
  usefulLifeMonths   Int
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  status             AssetStatus        @default(AVAILABLE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  assignments AssetAssignment[]

  @@index([organizationId])
  @@index([branchId])
}

model AssetAssignment {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  assetId        String
  asset          Asset     @relation(fields: [assetId], references: [id])
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  employeeId     String?
  employee       Employee? @relation(fields: [employeeId], references: [id])
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([projectId])
  @@index([assetId])
  @@index([branchId])
}

model Country {
  id   String @id @default(cuid())
  code String @unique
  name String

  safetyRequirements SafetyRequirement[]
  projects           Project[]
}

model SafetyRequirement {
  id               String                    @id @default(cuid())
  countryId        String
  country          Country                   @relation(fields: [countryId], references: [id])
  projectTypes     ProjectType[]
  category         SafetyRequirementCategory
  title            String
  description      String
  legalReference   String
  triggerCondition String?
  requiredRole     String?
  requiredDocument String?
  mandatory        Boolean                   @default(true)
  recurring        Boolean                   @default(false)
  recurrenceMonths Int?
  sortOrder        Int                       @default(0)
  active           Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  projectItems ProjectSafetyItem[]

  @@index([countryId])
  @@index([countryId, active])
}

model ProjectSafetyItem {
  id                     String            @id @default(cuid())
  organizationId         String
  branchId               String?
  projectId              String
  project                Project           @relation(fields: [projectId], references: [id])
  requirementId          String
  requirement            SafetyRequirement @relation(fields: [requirementId], references: [id])
  status                 SafetyItemStatus  @default(NOT_STARTED)
  assignedToEmployeeId   String?
  assignedTo             Employee?         @relation("SafetyItemAssignee", fields: [assignedToEmployeeId], references: [id])
  dueDate                DateTime?
  completedDate          DateTime?
  evidenceFileUrl        String?
  notes                  String?
  verifiedByProfessional Boolean           @default(false)
  verifiedByName         String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([projectId, requirementId])
  @@index([projectId])
  @@index([organizationId])
  @@index([requirementId])
}

// ─── SITES (DVR SCOPE) ─────────────────────────────────────────────────────────

model Site {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?      @relation(fields: [branchId], references: [id])
  name             String
  legalEntityName  String?
  vatNumber        String?
  taxCode          String?
  atecoCode        String?
  atecoDescription String?
  address          String?
  city             String?
  country          String?
  workingHours     String?
  shiftPattern     String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  dvr               DvrSetup?
  safetyRoles       SafetyRoleAppointment[]
  workerGroups      HomogeneousWorkerGroup[]
  processes         SiteProcess[]
  siteEquipment     SiteEquipment[]
  correctiveActions CorrectiveAction[]
  trainingRecords   SiteTrainingRecord[]
  incidents         SiteIncident[]
  contractors       Contractor[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([branchId])
}

model DvrSetup {
  id                    String    @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId              String?
  branch                Branch?   @relation(fields: [branchId], references: [id])
  siteId                String    @unique
  site                  Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  documentNumber        String?
  version               Int       @default(1)
  status                DvrStatus @default(SETUP)
  assessmentScope       String?
  assessmentDate        DateTime?
  nextReviewDate        DateTime?
  reviewFrequencyMonths Int       @default(12)
  overrideJustification String?
  overrideById          String?
  overrideAt            DateTime?
  approvedAt            DateTime?
  approvedByName        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  approvalSignatures DvrApprovalSignature[]

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
}

model DvrApprovalSignature {
  id         String   @id @default(cuid())
  dvrId      String
  roleType   String
  signerName String
  signedAt   DateTime @default(now())
  notes      String?

  dvr DvrSetup @relation(fields: [dvrId], references: [id], onDelete: Cascade)

  @@unique([dvrId, roleType])
  @@index([dvrId])
}

model SafetyRoleAppointment {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?        @relation(fields: [branchId], references: [id])
  siteId          String
  site            Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  roleType        SafetyRoleType
  employeeId      String?
  employee        Employee?      @relation(fields: [employeeId], references: [id])
  externalName    String?
  appointmentDate DateTime
  expiryDate      DateTime?
  documentUrl     String?
  isActive        Boolean        @default(true)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
  @@index([siteId])
  @@index([branchId])
  @@index([siteId, roleType])
  @@index([employeeId])
}

model HomogeneousWorkerGroup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  siteId         String
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members         WorkerGroupMember[]
  taskLinks       TaskWorkerGroup[]
  trainingRecords SiteTrainingRecord[]

  @@unique([siteId, code])
  @@index([organizationId])
  @@index([siteId])
  @@index([branchId])
}

model WorkerGroupMember {
  id         String                 @id @default(cuid())
  groupId    String
  group      HomogeneousWorkerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee               @relation(fields: [employeeId], references: [id])
  addedAt    DateTime               @default(now())

  @@unique([groupId, employeeId])
  @@index([employeeId])
  @@index([groupId])
}

// ─── DVR PHASE 2 — TASK INVENTORY & EQUIPMENT ─────────────────────────────────

model SiteProcess {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activities SiteActivity[]

  @@unique([siteId, name])
  @@index([organizationId])
  @@index([siteId])
}

model SiteActivity {
  id          String      @id @default(cuid())
  processId   String
  process     SiteProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tasks SiteTask[]

  @@unique([processId, name])
  @@index([processId])
}

model SiteTask {
  id                String       @id @default(cuid())
  activityId        String
  activity          SiteActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  normalOp          Boolean      @default(true)
  setupShutdown     Boolean      @default(false)
  maintenance       Boolean      @default(false)
  emergencyRecovery Boolean      @default(false)
  contractorWork    Boolean      @default(false)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workerGroups     TaskWorkerGroup[]
  equipmentLinks   TaskEquipment[]
  hazardScreenings TaskHazardScreening[]

  @@unique([activityId, name])
  @@index([activityId])
}

model TaskWorkerGroup {
  taskId  String
  task    SiteTask               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  groupId String
  group   HomogeneousWorkerGroup @relation(fields: [groupId], references: [id])

  @@id([taskId, groupId])
  @@index([groupId])
}

model TaskHazardScreening {
  id                   String   @id @default(cuid())
  taskId               String
  task                 SiteTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  hazardCode           String
  isApplicable         Boolean
  justification        String?
  assessorName         String?
  screenedAt           DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Risk assessment fields (P × D = R)
  probability          Int?
  damage               Int?
  riskLevel            Int?
  riskClass            String?
  mitigationMeasures   String?
  residualProbability  Int?
  residualDamage       Int?
  residualRiskLevel    Int?
  residualRiskClass    String?

  correctiveActions    CorrectiveAction[]
  incidents            SiteIncident[]

  @@unique([taskId, hazardCode])
  @@index([taskId])
}

model SiteEquipment {
  id                        String    @id @default(cuid())
  organizationId            String
  siteId                    String
  site                      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name                      String
  category                  String
  serialNumber              String?
  manufacturer              String?
  model                     String?
  certificationRef          String?
  inspectionFrequencyMonths Int?
  lastInspectionDate        DateTime?
  nextInspectionDate        DateTime?
  notes                     String?
  isActive                  Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  taskLinks TaskEquipment[]

  @@index([organizationId])
  @@index([siteId])
}

model TaskEquipment {
  taskId      String
  task        SiteTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   SiteEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([taskId, equipmentId])
  @@index([equipmentId])
}

// ─── CORRECTIVE ACTIONS ───────────────────────────────────────────────────────

model CorrectiveAction {
  id             String                   @id @default(cuid())
  organizationId String
  siteId         String
  hazardId       String?

  title            String
  description      String?
  priority         CorrectiveActionPriority
  status           CorrectiveActionStatus   @default(OPEN)

  assignedToId     String?
  dueDate          DateTime?
  completedDate    DateTime?
  verificationNote String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site         Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization          @relation(fields: [organizationId], references: [id])
  hazard       TaskHazardScreening?  @relation(fields: [hazardId], references: [id], onDelete: SetNull)
  assignedTo   Employee?             @relation("correctiveActionAssignee", fields: [assignedToId], references: [id])

  @@index([siteId])
  @@index([organizationId])
  @@index([status])
}

// ─── TRAINING & COMPETENCY RECORDS ───────────────────────────────────────────

model SiteTrainingRecord {
  id             String               @id @default(cuid())
  organizationId String
  siteId         String
  workerGroupId  String?
  employeeId     String?

  trainingType   String
  description    String?
  trainerName    String?
  trainingDate   DateTime
  expiryDate     DateTime?
  certificateRef String?
  status         TrainingRecordStatus @default(VALID)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site         Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization            @relation(fields: [organizationId], references: [id])
  workerGroup  HomogeneousWorkerGroup? @relation(fields: [workerGroupId], references: [id], onDelete: SetNull)
  employee     Employee?               @relation("trainingRecordEmployee", fields: [employeeId], references: [id])

  @@index([siteId])
  @@index([organizationId])
  @@index([status])
}

// ─── INCIDENT & NEAR-MISS REGISTER ───────────────────────────────────────────

model SiteIncident {
  id             String           @id @default(cuid())
  organizationId String
  siteId         String

  incidentType    IncidentType
  severity        IncidentSeverity
  status          IncidentStatus   @default(REPORTED)

  incidentDate    DateTime
  reportedDate    DateTime         @default(now())
  title           String
  description     String?
  location        String?
  injuredPerson   String?
  witnesses       String?
  immediateAction String?
  rootCause       String?

  hazardId    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site         Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id])
  hazard       TaskHazardScreening? @relation(fields: [hazardId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([organizationId])
  @@index([status])
  @@index([incidentDate])
}

// ─── CONTRACTOR MANAGEMENT ────────────────────────────────────────────────────

model Contractor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  companyName  String
  vatNumber    String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  workScope    String?
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean  @default(true)

  workers ContractorWorker[]
  permits ContractorAccessPermit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, siteId])
}

model ContractorWorker {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  fullName       String
  role           String?
  idNumber       String?
  inductionDate  DateTime?
  inductionValid Boolean   @default(false)
  certifications String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractorId])
}

model ContractorAccessPermit {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  permitType   String
  permitNumber String?
  issuedDate   DateTime
  expiryDate   DateTime
  issuedById   String?
  workArea     String?
  conditions   String?
  status       String    @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractorId])
  @@index([expiryDate])
}
