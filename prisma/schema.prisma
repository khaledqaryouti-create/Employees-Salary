// ─── PROJECT MODULE ───────────────────────────────────────────────────────────

model Project {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  branchId        String?
  branch          Branch?        @relation(fields: [branchId], references: [id])
  code            String
  name            String
  description     String?
  clientName      String?
  status          ProjectStatus  @default(PLANNING)
  startDate       DateTime
  endDate         DateTime?
  budgetAmount    Decimal?       @db.Decimal(14,2)
  currency        String         @default("USD")
  costCenter      String?
  orgUnitId       String?
  orgUnit         OrgUnit?       @relation(fields: [orgUnitId], references: [id])
  managerId       String?
  manager         Employee?      @relation("ProjectManager", fields: [managerId], references: [id])
  billable               Boolean        @default(true)
  allocationMode         AllocationMode @default(PERCENTAGE)
  overheadFormula        String?
  projectType            ProjectType?
  countryId              String?
  country                Country?       @relation(fields: [countryId], references: [id])
  buildingHeightMeters   Float?
  hasElectricalWorks     Boolean        @default(false)
  hasMultipleContractors Boolean        @default(false)
  occupancyType          String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  resourceAssignments  ResourceAssignment[]
  assetAssignments     AssetAssignment[]
  costDistributions    CostDistribution[]
  budgetLines          ProjectBudgetLine[]
  safetyRequirements   ProjectSafetyRequirement[]
  safetyItems          ProjectSafetyItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([organizationId, status])
  @@index([countryId])
}

model ResourceAssignment {
  id             String           @id @default(cuid())
  organizationId String
  branchId       String?
  branch         Branch?          @relation(fields: [branchId], references: [id])
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id])
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  role           String
  allocationPct  Decimal?         @db.Decimal(5,2)
  hoursPerWeek   Decimal?         @db.Decimal(6,2)
  billableRate   Decimal?         @db.Decimal(12,2)
  startDate      DateTime
  endDate        DateTime?
  status         AssignmentStatus @default(APPROVED)
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([employeeId])
  @@index([projectId])
  @@index([branchId])
}

model ProjectSafetyRequirement {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id])
  title          String
  description    String?
  mandatory      Boolean   @default(true)
  completedAt    DateTime?
  completedById  String?
  completedBy    Employee? @relation("SafetyCompletedBy", fields: [completedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([projectId])
  @@index([organizationId])
  @@index([branchId])
}

model CostDistribution {
  id                        String         @id @default(cuid())
  organizationId            String
  branchId                  String?
  branch                    Branch?        @relation(fields: [branchId], references: [id])
  projectId                 String
  project                   Project        @relation(fields: [projectId], references: [id])
  employeeId                String
  employee                  Employee       @relation(fields: [employeeId], references: [id])
  periodStart               DateTime
  periodEnd                 DateTime
  allocatedCost             Decimal        @db.Decimal(14,2)
  calculationMode           AllocationMode
  snapshotAllocationPct     Decimal?       @db.Decimal(5,2)
  snapshotTotalEmployeeCost Decimal?       @db.Decimal(14,2)
  payrollRunId              String?
  createdAt                 DateTime       @default(now())

  @@unique([projectId, employeeId, periodStart, periodEnd])
  @@index([organizationId])
  @@index([employeeId, periodStart])
  @@index([branchId])
}

model ProjectBudgetLine {
  id             String         @id @default(cuid())
  organizationId String
  branchId       String?
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id])
  category       BudgetCategory
  plannedAmount  Decimal        @db.Decimal(14,2)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime       @default(now())

  @@index([projectId])
  @@index([organizationId])
  @@index([branchId])
}

